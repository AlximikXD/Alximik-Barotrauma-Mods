  <!-- /// Treatments /// -->
  <entityname.mannitol>Манітол</entityname.mannitol>
  <entitydescription.mannitol>Тип цукрового спирту. Використовується для сприяння відновленню після нейротравми. Може спричинити пошкодження органів.</entitydescription.mannitol>
  <entityname.streptokinase>Стрептокіназа</entityname.streptokinase>
  <entitydescription.streptokinase>Тромболітичний фермент, що розщеплює кров’яні згустки. Використовується для лікування інфарктів. Знижує здатність крові до згортання.</entitydescription.streptokinase>
  <entityname.immunosuppressant>Азатіоприн</entityname.immunosuppressant>
  <entitydescription.immunosuppressant>Імуносупресивний засіб для запобігання відторгненню трансплантованих органів.</entitydescription.immunosuppressant>
  <entityname.thiamine>Тіамін</entityname.thiamine>
  <entitydescription.thiamine>Також відомий як вітамін B1, цей препарат сприяє відновленню органів.</entitydescription.thiamine>
  <entityname.pressuremeds>Нітропрусид натрію</entityname.pressuremeds>
  <entitydescription.pressuremeds>Препарат, що використовується для зниження артеріального тиску.</entitydescription.pressuremeds>
  <entityname.ointment>Антибіотична мазь</entityname.ointment>
  <entitydescription.ointment>Гель з потужними антисептичними властивостями, допомагає у відновленні після опіків так само добре, як і при інфікуванні.</entitydescription.ointment>
  <entityname.endovascballoon>Ендоваскулярний балон</entityname.endovascballoon>
  <entitydescription.endovascballoon>Балон, що вставляється у великі артерії при їх розриві. Зупиняє як кровообіг, так і кровотечу.</entitydescription.endovascballoon>
  <entityname.medstent>Медичний стент</entityname.medstent>
  <entitydescription.medstent>Пластикова трубка, вставлена після ендоваскулярного балона при розриві аорти.</entitydescription.medstent>
  <entityname.tourniquet>Турнікет</entityname.tourniquet>
  <entitydescription.tourniquet>Пристрій, що стискає частину тіла, обмежуючи кровотік. Зазвичай використовується при сильних кровотечах з кінцівок. Не рекомендується застосовувати до голови.</entitydescription.tourniquet>
  <entityname.drainage>Дренаж</entityname.drainage>
  <entitydescription.drainage>Видаляє повітря з плевральної порожнини під час коригувальної операції при пневмотораксі.</entitydescription.drainage>
  <entityname.needle>Голка</entityname.needle>
  <entitydescription.needle>Голка з декомпресійним клапаном для видалення рідини або повітря з плевральної порожнини чи перикарда.</entitydescription.needle>
  <entityname.ringerssolution>Розчин Рінгера</entityname.ringerssolution>
  <entitydescription.ringerssolution>Розчин кількох солей у воді, призначений для лікування низького тиску або втрати рідини. Ізотонічний до крові.</entitydescription.ringerssolution>
  <entityname.antiseptic>Антисептик</entityname.antiseptic>
  <entitydescription.antiseptic>Використовується для лікування інфікованих ран шляхом розпилення за допомогою антисептичного спрею.</entitydescription.antiseptic>
  <entityname.antisepticspray>Антисептичний спрей</entityname.antisepticspray>
  <entitydescription.antisepticspray>Використовується для нанесення антисептика на інфіковані рани.</entitydescription.antisepticspray>
  <entityname.propofol>Пропофол</entityname.propofol>
  <entitydescription.propofol>Препарат короткочасної дії, що спричиняє втрату свідомості та викликає амнезію подій. Використовується для введення у загальну анестезію та її підтримки.</entitydescription.propofol>
  <entityname.gypsum>Гіпс</entityname.gypsum>
  <entitydescription.gypsum>Дрібнозернистий мінеральний порошок, що використовується для покриття та фіксації переломів кінцівок. Спочатку накладіть бинт.</entitydescription.gypsum>
  <entityname.gelipack>Гіпотермічний пакет</entityname.gelipack>
  <entitydescription.gelipack>Багаторазовий охолоджувальний пакет, наповнений органічним гелем, який ніколи не псується. Втрачає ефективність без охолодження.</entitydescription.gelipack>
