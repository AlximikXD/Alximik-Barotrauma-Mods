<?xml version="1.0" encoding="utf-8"?>
<Items>
  <Override>
        <!-- Cyborg Helmet -->
        <Item name="" identifier="cyborghelmet" scale="0.325" category="Diving" tags="smallitem,clothing,cyborghelmet" allowasextracargo="true" cargocontaineridentifier="metalcrate" impactsoundtag="impact_metal_light" description="" hideinmenus="false">
            <PreferredContainer primary="divingsuitcontainer" secondary="divingcab"/>
            <Price baseprice="350" sold="false">
                <Price storeidentifier="merchantoutpost" multiplier="1.3" />
                <Price storeidentifier="merchantcity" multiplier="1.2" />
                <Price storeidentifier="merchantresearch" />
                <Price storeidentifier="merchantmilitary" multiplier="1.25" />
                <Price storeidentifier="merchantmine" />
            </Price>
            <Deconstruct time="20">
                <Item identifier="fulgurium" amount="3" />
                <Item identifier="oxygeniteshard" />
                <Item identifier="lead" />
                <Item identifier="copper" amount="2" />
                <Item identifier="plastic" amount="2" />
            </Deconstruct>
            <Fabricate suitablefabricators="fabricator" requiredtime="40" requiresrecipe="true">
                <RequiredSkill identifier="electrical" level="20" />
                <RequiredSkill identifier="mechanical" level="20" />
                <RequiredItem identifier="fulgurium" amount="2" />
                <RequiredItem identifier="oxygeniteshard" amount="2" />
                <RequiredItem identifier="alienpowercell" amount="2" />
                <RequiredItem identifier="healthscanner" />
                <RequiredItem identifier="thermalgoggles" />
            </Fabricate>
            <InventoryIcon texture="%ModDir:2967334496%/Items/CyborgArmor.png" sourcerect="128,384,128,128" origin="0.5,0.5" />
            <Sprite name="Cyborg Helmet" texture="%ModDir:2967334496%/Items/CyborgArmor.png" sourcerect="128,384,128,128" depth="0.6" origin="0.5,0.5" />
            <Body width="42" height="72" density="20" />
            <Wearable limbtype="Head" slots="Any,Head" msg="ItemMsgPickUpSelect">
                <sprite name="Cyborg Helmet" texture="%ModDir:2967334496%/Characters/HumanCyborg/head.png" limb="Head" inheritlimbdepth="true" inheritscale="true" ignorelimbscale="true" scale="0.6" hidelimb="true" alphaclipotherwearables="true" sourcerect="0,0,128,160" origin="0.5,0.35">
                    <LightComponent range="60.0" lightcolor="255,255,255,192" powerconsumption="10" IsOn="true" CastShadows="false">
                    <LightTexture texture="Content/Lights/pointlight_rays.png" origin="0.5, 0.5" size="1.0,1.0" />
                    <StatusEffect type="OnWearing" target="This,Character" Voltage="1.0" setvalue="true" comparison="and">
                        <Conditional IsDead="false" />
                        <conditional cyborgrevolution="gt 0" />
                    </StatusEffect>
                    </LightComponent>
                </sprite>
                <!-- Damage reduction -->
                <damagemodifier armorsector="0.0,360.0" afflictionidentifiers="lacerations,bitewounds,blunttrauma" damagemultiplier="0.15" damagesound="LimbArmor" deflectprojectiles="true" />
                <damagemodifier armorsector="0.0,360.0" afflictionidentifiers="explosiondamage,gunshotwound" damagemultiplier="0.30" damagesound="LimbArmor" deflectprojectiles="true" />
                <damagemodifier armorsector="0.0,360.0" afflictiontypes="bleeding" damagemultiplier="0.5" damagesound="LimbArmor" deflectprojectiles="true" />
                <damagemodifier armorsector="0.0,360.0" afflictiontypes="burn" damagemultiplier="0.5" damagesound="LimbArmor" deflectprojectiles="true" />
                <damagemodifier armorsector="0.0,360.0" afflictionidentifiers="concussion" damagemultiplier="0.0" damagesound="" deflectprojectiles="true" />
                <!-- Damage user who has no cyborg genes -->
                <StatusEffect type="OnWearing" target="Character">
                    <Conditional cyborgeffects="lte 0" />
                    <Affliction identifier="internaldamage" amount="0.5" />
                    <Affliction identifier="organdamage" amount="0.5" />
                </StatusEffect>
                <!-- Oxygen supply -->
                <StatusEffect type="OnWearing" target="Character" OxygenAvailable="1000.0" HideFace="true">
                    <Conditional HasStatusTag="powered" />
                    <ReduceAffliction type="oxygenlow" amount="1.0" />
                </StatusEffect>
                <!-- Thermal vision -->
                <StatusEffect type="OnWearing" target="This,Character" interval="0.9" disabledeltatime="true" comparison="And">
                    <Conditional HasStatusTag="powered"/>
                    <Conditional IsOn="true" targetitemcomponent="LightComponent" />
                    <Affliction identifier="cyborgthermalvision" amount="1.0" />
                </StatusEffect>
                <!-- <StatusEffect type="OnWearing" target="This,Character" disabledeltatime="true" multiplyafflictionsbymaxvitality="true" >
                    <Conditional hasstatustag="ThermalOff" TargetSelf="true" />
                    <ReduceAffliction identifier="cyborgthermalvision" amount="1.0" />
                </StatusEffect> -->
            </Wearable>
            <!-- Health scanner -->
            <StatusHUD drawhudwhenequipped="true" range="500" thermalgoggles="false" showdeadcharacters="true" showtexts="true" />
            <!-- Thermal Vision switch -->
            <CustomInterface canbeselected="false" drawhudwhenequipped="true" allowuioverlap="true">
                <GuiFrame relativesize="0.12,0.09" anchor="BottomCenter" relativeoffset="0.1,0.1" style="ItemUI" />
                <TickBox text="thermalvision.active" signal="true" targetitemcomponent="LightComponent" propertyname="IsOn" ContinuousSignal="false" GetValueInterval="1" />
            </CustomInterface>
            <Holdable slots="RightHand+LeftHand" controlpose="true" holdpos="50,-50" handle1="-10,-20" handle2="10,-20" holdangle="0" msg="ItemMsgPickUpUse" canbeselected="false" canbepicked="true" pickkey="Use" />
            <aitarget maxsightrange="1500" />
        </Item>
  </Override>
</Items>