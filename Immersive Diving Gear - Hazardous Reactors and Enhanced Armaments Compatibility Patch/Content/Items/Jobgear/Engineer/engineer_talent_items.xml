<?xml version="1.0" encoding="utf-8"?>
<Items>
    <Override>
        <!-- Bot Diving Helmet (PUCS) -->
        <Item name="" identifier="botpucsdivingsuithelmet" tags="bothelmet" scale="0.3" fireproof="true" description="" allowdroppingonswapwith="diving" impactsoundtag="impact_metal_light" botpriority="1" hideinmenus="true">
            <Sprite name="Bot PUCS Diving Helmet Item" texture="Content/Items/Jobgear/headgears.png" sourcerect="127,520,105,124" depth="0.55" origin="0.5,0.5"/>
            <InventoryIcon texture="Content/Items/Jobgear/headgears.png" sourcerect="127,520,105,124" depth="0.55" origin="0.5,0.5"/>
            <ItemComponent canbeselected="false" allowingameediting="false">
                <!-- apply low pass filter when worn -->
                <StatusEffect type="OnWearing" target="Character" LowPassMultiplier="0.2" setvalue="true" disabledeltatime="true"/>
                <!-- obstruct vision -->
                <StatusEffect type="OnWearing" target="Character" ObstructVision="true" setvalue="true" disabledeltatime="true"/>
                <!-- play air breathing sound when not in water -->
                <StatusEffect type="OnWearing" target="Character" comparison="And">
                    <Conditional InWater="false"/>
                    <Conditional IsDead="false"/>
                    <Sound file="Content/Items/Diving/DivingSuitLoop1.ogg" range="250" volume="1.5" loop="true"/>
                </StatusEffect>
                <!-- play underwater breathing sound and create bubbles when in water -->
                <StatusEffect type="OnWearing" target="limb" targetlimb="head" interval="6" duration="0.5" comparison="And">
                    <Conditional InWater="true"/>
                    <Conditional IsDead="false"/>
                    <Sound file="%ModDir:3074045632%/Content/Items/Diving/DivingSuitBreathUnderwater1.ogg" range="400" volume="1.5" selectionmode="Random"/>
                    <Sound file="%ModDir:3074045632%/Content/Items/Diving/DivingSuitBreathUnderwater2.ogg" range="400" volume="1.5" selectionmode="Random"/>
                    <Sound file="%ModDir:3074045632%/Content/Items/Diving/DivingSuitBreathUnderwater3.ogg" range="400" volume="1.5" selectionmode="Random"/>
                    <Sound file="%ModDir:3074045632%/Content/Items/Diving/DivingSuitBreathUnderwater4.ogg" range="400" volume="1.5" selectionmode="Random"/>
                    <ParticleEmitter particle="risingbubbles" velocitymin="10.0" velocitymax="10.0" scalemin="0.6" scalemax="0.6" particlespersecond="20"/>
                </StatusEffect>
            </ItemComponent>
            <!-- GreaterComponent used to toggle between releasing or building up pressure by changing and checking for the timeframe value (1 = closed valve, 0 = open valve) -->
            <GreaterComponent canbeselected="false" canbepicked="false" allowingameediting="false" timeframe="0">
                <!-- tag the character and helmet with "sealed" when wearing the suit, the pressure valve is closed and the character has the "hashelmet" and "hasseal" tags -->
                <StatusEffect type="OnWearing" target="This,Character" tags="sealed" interval="0.1" duration="0.2" comparison="And">
                    <Conditional timeframe="eq 1"/>
                    <Conditional HasStatusTag="eq hassuit"/>
                    <Conditional HasStatusTag="eq hasseal"/>
                </StatusEffect>
                <!-- release pressure visually -->
                <StatusEffect type="OnWearing" target="This,Character" tags="releasepressure" interval="0.1" duration="0.2" comparison="And">
                    <Conditional timeframe="eq 0"/>
                </StatusEffect>
                <!-- close the pressure valve when worn by a concious bot -->
                <StatusEffect type="OnWearing" target="This,Character" timeframe="1" setvalue="true" interval="0.1" comparison="And">
                    <Conditional timeframe="eq 0"/>
                    <Conditional IsBot="true"/>
                    <Conditional vitaltiy="gt 0"/>
                </StatusEffect>
                <!-- close the pressure valve when worn by a concious bot | NT compatibility -->
                <StatusEffect type="OnWearing" target="This,Character" timeframe="1" setvalue="true" interval="0.1" comparison="And">
                    <Conditional timeframe="eq 0"/>
                    <Conditional IsBot="true"/>
                    <Conditional sym_unconsciousness="lte 0"/>
                </StatusEffect>
                <!-- open the pressure valve if the wearer has the affliction "openvalve" while the pressure valve is closed -->
                <StatusEffect type="OnWearing" target="This" timeframe="0" setvalue="true" interval="0.1" comparison="And">
                    <Conditional timeframe="eq 1"/>
                    <Conditional openvalve="gt 0" targetcontainer="true"/>
                    <Sound file="%ModDir:3074045632%/Content/Items/Diving/OpenValve.ogg" volume="3.5" range="150"/>
                </StatusEffect>
                <!-- close the pressure valve if the wearer has the affliction "closevalve" while the pressure valve is open -->
                <StatusEffect type="OnWearing" target="This" timeframe="1" setvalue="true" interval="0.1" comparison="And">
                    <Conditional timeframe="eq 0"/>
                    <Conditional closevalve="gt 0" targetcontainer="true"/>
                    <Sound file="%ModDir:3074045632%/Content/Items/Diving/CloseValve.ogg" volume="3.5" range="150"/>
                </StatusEffect>
            </GreaterComponent>
            <Wearable slots="OuterClothes" msg="ItemMsgEquipSelect" displaycontainedstatus="true" canbeselected="false" canbepicked="true" pickkey="Select">
                <sprite name="Diving Suit Helmet Wearable" texture="Content/Items/Jobgear/headgears.png" limb="Head" inheritlimbdepth="true" inheritscale="true" ignorelimbscale="true" scale="0.65" hidelimb="false" alphaclipotherwearables="true" sourcerect="127,520,105,124" origin="0.5,0.5">
                    <LightComponent range="700.0" lightcolor="250,224,165,175" powerconsumption="0" IsOn="true" allowingameediting="false">
                        <StatusEffect type="OnWearing" target="This,Character" Voltage="1.0" Interval="0.1" setvalue="true">
                            <Conditional IsDead="false"/>
                        </StatusEffect>
                        <LightTexture texture="Content/Lights/divinghelmetlight.png" origin="0.05, 0.5" size="1.0,1.0"/>
                    </LightComponent>
                </sprite>
                <damagemodifier armorsector="0.0,360.0" afflictionidentifiers="contamination" probabilitymultiplier="0" damagesound="armourmedimpact"/>
                <!-- tag the character with "bothelmet" and "hashelmet" | this prevents the player from dying when switching to a bot in water -->
                <StatusEffect type="OnWearing" target="Character" tags="hashelmet,bothelmet" setvalue="true" duration="0.1"/>
                <!-- remove the item when it's not contained -->
                <StatusEffect type="OnNotContained" target="This">
                    <Remove/>
                </StatusEffect>
                <!-- drop the helmet when the wearer is not a bot, not in water and isn't pressurized -->
                <StatusEffect type="OnWearing" target="This" comparison="And">
                    <Conditional IsBot="false" targetcontainer="true"/>
                    <Conditional InWater="false" targetcontainer="true"/>
                    <Conditional HasStatusTag="neq pressurized" targetcontainer="true"/>
                    <DropItem/>
                </StatusEffect>
                <!-- drop the helmet if the bot unequips the suit -->
                <StatusEffect type="OnWearing" target="This" comparison="And">
                    <Conditional IsBot="true" targetcontainer="true"/>
                    <Conditional HasStatusTag="neq botsuit" targetcontainer="true"/>
                    <DropItem/>
                </StatusEffect>
            </Wearable>
            <!-- HELMET INVENTORY | spawns with battery and seal for this specific helmet and is locked -->
            <ItemContainer capacity="0" hideitems="true" spawnwithid="batterycell,suitseal" containedstateindicatorslot="1" allowaccess="false" locked="true">
                <SlotIcon slotindex="1" texture="%ModDir:3074045632%/Content/Items/Diving/SuitSealIcon.png" sourcerect="0,0,60,55" origin="0.5,0.5"/>
                <SlotIcon slotindex="0" texture="Content/UI/StatusMonitorUI.png" sourcerect="128,448,64,64" origin="0.5,0.5"/>
