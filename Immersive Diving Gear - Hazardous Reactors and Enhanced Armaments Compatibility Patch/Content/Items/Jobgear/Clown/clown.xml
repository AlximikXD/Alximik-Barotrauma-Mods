				</StatusEffect>
			</ItemComponent>
			<!-- GreaterComponent used to toggle between releasing or building up pressure by changing and checking for the timeframe value (1 = closed valve, 0 = open valve) -->
			<GreaterComponent canbeselected="false" canbepicked="false" allowingameediting="false" timeframe="0">
				<!-- tag the character and helmet with "sealed" when wearing the suit, the pressure valve is closed and the character has the "hashelmet" and "hasseal" tags -->
				<StatusEffect type="OnWearing" target="This,Character" tags="sealed" interval="0.1" duration="0.2" comparison="And">
					<Conditional timeframe="eq 1" />
					<Conditional HasStatusTag="eq hassuit" />
					<Conditional HasStatusTag="eq hasseal" />
				</StatusEffect>
				<!-- release pressure visually -->
				<StatusEffect type="OnWearing" target="This,Character" tags="releasepressure" interval="0.1" duration="0.2" comparison="And">
					<Conditional timeframe="eq 0" />
				</StatusEffect>
				<!-- close the pressure valve when worn by a concious bot -->
				<StatusEffect type="OnWearing" target="This,Character" timeframe="1" setvalue="true" interval="0.1" comparison="And">
					<Conditional timeframe="eq 0" />
					<Conditional IsBot="true" />
					<Conditional vitaltiy="gt 0" />
				</StatusEffect>
				<!-- close the pressure valve when worn by a concious bot | NT compatibility -->
				<StatusEffect type="OnWearing" target="This,Character" timeframe="1" setvalue="true" interval="0.1" comparison="And">
					<Conditional timeframe="eq 0" />
					<Conditional IsBot="true" />
					<Conditional sym_unconsciousness="lte 0" />
				</StatusEffect>
				<!-- open the pressure valve if the wearer has the affliction "openvalve" while the pressure valve is closed -->
				<StatusEffect type="OnWearing" target="This" timeframe="0" setvalue="true" interval="0.1" comparison="And">
					<Conditional timeframe="eq 1" />
					<Conditional openvalve="gt 0" targetcontainer="true" />
					<Sound file="%ModDir:3074045632%/Content/Items/Diving/OpenValve.ogg" volume="3.5" range="150" />
				</StatusEffect>
				<!-- close the pressure valve if the wearer has the affliction "closevalve" while the pressure valve is open -->
				<StatusEffect type="OnWearing" target="This" timeframe="1" setvalue="true" interval="0.1" comparison="And">
					<Conditional timeframe="eq 0" />
					<Conditional closevalve="gt 0" targetcontainer="true" />
